msgid "Check for updates"
msgstr "Leta efter uppdateringar"

msgctxt "#33162"
msgid "Reset the music library?"
msgstr "Återställ musikbiblioteket?"

msgctxt "#33163"
msgid "Support this project"
msgstr "Stöd detta projekt"

